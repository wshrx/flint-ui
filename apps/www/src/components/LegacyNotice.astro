---
const path = Astro.url.pathname
const match = path.match(/\/(v\d+(?:\.\d+)*)(?:\/|$)/)
const slug = match?.[1]
const version = slug?.replace(/^v/, "")

const dates: Record<string, string> = {
  "0.1.0": "28 October 2026",
  "0.1.1": "28 October 2026",
  "0.1.2": "29 October 2026",
}

const ru = Astro.currentLocale === "ru"
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---

{
  slug && (
    <p class="flint-version-notice">
      {ru ? (
        <>
          Вы читаете документацию {version} — предрелизный срез от {dates[version] ?? "того релиза"}. Он
          оставлен для справки: исправления из следующих версий сюда не переносятся.{" "}
          <a href={`${base}/docs/installation/`}>Актуальная документация</a>.
        </>
      ) : (
        <>
          You are reading the {version} documentation, a pre-release snapshot from{" "}
          {dates[version] ?? "that release"}. It is kept for reference: fixes released later are not
          backported. <a href={`${base}/docs/installation/`}>Read the current docs</a>.
        </>
      )}
    </p>
  )
}
