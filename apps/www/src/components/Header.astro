---
import SiteTitle from "virtual:starlight/components/SiteTitle"
import Search from "virtual:starlight/components/Search"
import ThemeSelect from "virtual:starlight/components/ThemeSelect"
import LanguageSelect from "virtual:starlight/components/LanguageSelect"
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle"

const ru = Astro.currentLocale === "ru"
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}${ru ? "/ru" : ""}`
---

<div class="flint-header">
  <div class="flint-header-start">
    <div class="flint-mobile-only">
      <MobileMenuToggle />
    </div>
    <SiteTitle />
    <nav class="flint-nav" aria-label={ru ? "Основная навигация" : "Primary"}>
      <a href={`${base}/docs/installation`}>{ru ? "Документация" : "Docs"}</a>
      <a href={`${base}/docs/components`}>{ru ? "Компоненты" : "Components"}</a>
      <a href={`${base}/docs/cli`}>CLI</a>
      <a href={`${base}/docs/registry`}>{ru ? "Реестр" : "Registry"}</a>
    </nav>
  </div>
  <div class="flint-header-end">
    <div class="flint-search"><Search /></div>
    <a class="flint-github" href="https://github.com/wshrx/flint-ui" aria-label="GitHub">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.42c.58.1.79-.25.79-.55v-2.1c-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.66.8.55A11.5 11.5 0 0 0 12 .5Z" />
      </svg>
    </a>
    <div class="flint-lang"><LanguageSelect /></div>
    <ThemeSelect />
  </div>
</div>
