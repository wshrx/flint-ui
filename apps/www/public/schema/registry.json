{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wshrx.github.io/flint-ui/schema/registry.json",
  "title": "flint registry",
  "description": "The manifest flint-ui reads before it copies anything.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "type": {
            "enum": ["registry:ui", "registry:lib", "registry:file"]
          },
          "description": { "type": "string" },
          "registryDependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "type": { "type": "string" }
              },
              "required": ["path", "type"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "type", "files"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "items"],
  "additionalProperties": false
}
