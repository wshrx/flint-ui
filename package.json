{
  "name": "flint",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "bun run --cwd packages/flint typecheck && bun run --cwd packages/cli typecheck && bun run --cwd apps/www typecheck",
    "build": "bun run --cwd packages/flint build && bun run --cwd packages/cli build && bun run --cwd apps/www build",
    "dev": "bun run --cwd apps/www dev",
    "test": "bun test",
    "registry:check": "bun run scripts/check-registry.ts",
    "contrast": "bun run scripts/contrast.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "typescript": "7.0.2"
  }
}
